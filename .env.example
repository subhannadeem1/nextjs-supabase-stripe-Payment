# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/business_os?retryWrites=true&w=majority"
# Optional: database name if it isn't in the URI
MONGODB_DB=""

# Your login (only this email + password can sign in)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password"

# Random secret for signing the login cookie (32+ characters).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""
